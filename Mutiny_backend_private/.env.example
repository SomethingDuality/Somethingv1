# Local development defaults. They work with `docker compose up -d --wait` at the repo root.
# Copy to .env. Never put real production secrets in this file.

# 5050, not 5000: macOS AirPlay Receiver (ControlCenter) listens on 5000.
PORT=5050
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/something?directConnection=true

# Dev-only placeholders. For anything real, generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=dev_access_secret_change_me
REFRESH_TOKEN_SECRET=dev_refresh_secret_change_me

REDIS_URL=redis://localhost:6379

# When false (or when the broker is down), events run in-process instead.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=something-backend
KAFKA_GROUP_ID=something-side-effects

# One-click "Continue as test founder / investor" on /login (npm run dev:memory turns it on).
# Ignored whenever NODE_ENV=production.
# DEV_LOGIN=true

# Who can open /admin (investor verification). Comma-separated emails; put your own here.
# ADMIN_EMAILS=

# console = password-reset links are printed in the server log.
MAIL_TRANSPORT=console

# Google Identity Services Web client ID. Leave blank to turn Google sign-in off.
GOOGLE_CLIENT_ID=

# libuv thread pool — min(CPU cores * 4, 128)
UV_THREADPOOL_SIZE=16

# The Python agent service (agent/). Node calls it at AGENT_URL with NODE_TO_AGENT_KEY; it calls
# Node's internal API on 127.0.0.1:INTERNAL_PORT with AGENT_TO_NODE_KEY. Generate real keys with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# npm run dev:memory sets dev-only placeholders, which the agent refuses in production.
# AGENT_ENABLED=true
# AGENT_URL=http://127.0.0.1:8000
# NODE_TO_AGENT_KEY=
# AGENT_TO_NODE_KEY=
# INTERNAL_PORT=5051
# MONGO_MEMORY_PORT=27018
