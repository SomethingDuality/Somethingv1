# The Python agent service. Copy to agent/.env (git-ignored). Names only here: never commit values.

# dev | test | production. Production refuses fake mode and the dev placeholder keys below.
AGENT_ENV=dev
# Where Node's dev:memory runs MongoDB (a one-node replica set; transactions need one).
MONGO_URI=mongodb://127.0.0.1:27018/something_dev?replicaSet=rs0
NODE_INTERNAL_URL=http://127.0.0.1:5051

# Service keys, one per direction. Dev placeholders match npm run dev:memory; generate real ones with
#   python3 -c "import secrets; print(secrets.token_hex(32))"
NODE_TO_AGENT_KEY=dev-only-node-to-agent
AGENT_TO_NODE_KEY=dev-only-agent-to-node

# true = scripted model answers and fake embeddings (no keys, no network). Set false once keys are in.
AGENT_FAKE_LLM=true

# Model keys (Somay adds these himself). Claude judges; the free chains do cheap work.
ANTHROPIC_API_KEY=
JINA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GOOGLE_API_KEY=

# Which free providers may see founders' own text (ideas, answers). Others only see our own text.
USER_TEXT_PROVIDERS=groq,cerebras,sambanova

# Limits (R7) and the daily spend breaker in USD.
REVIEWS_PER_DAY=3
CHAT_TURNS_PER_DAY=30
DAILY_USD_CAP=5
